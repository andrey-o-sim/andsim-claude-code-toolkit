{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/pre-commit/pre-commit.sh\"",
            "statusMessage": "Pre-commit: build, format, tests"
          }
        ]
      }
    ]
  }
}